# ─────────────────────────────────────────────────────────────────────────────
# Primsett Environment Variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ── Auth (Clerk) ───────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Redis ─────────────────────────────────────────────────────────────────────
# Development: redis://localhost:6379 (run redis-server locally)
# Production: Upstash — rediss://[token]@[host]:6379
REDIS_URL=redis://localhost:6379

# ── Payments (Paystack) ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
# Used to verify Paystack webhook signatures
PAYSTACK_WEBHOOK_SECRET=...

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
# Set during webhook registration in Meta developer console
WHATSAPP_VERIFY_TOKEN=primsett_verify_token_change_this
# App secret for HMAC signature verification
WHATSAPP_APP_SECRET=...

# ── Image Storage (Cloudinary) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ── Analytics (PostHog) ────────────────────────────────────────────────────────
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── App URLs ───────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Node ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
